{
  "name": "capscribe-desktop",
  "version": "1.0.0",
  "description": "CapCut-inspired Roman Urdu Caption Generator Desktop App",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"node electron/launch.cjs --dev\"",
    "dev:renderer": "vite",
    "dev:electron": "node electron/launch.cjs --dev",
    "build": "vite build",
    "start": "node electron/launch.cjs"
  },
  "keywords": [
    "electron",
    "captions",
    "subtitles",
    "roman-urdu",
    "capcut",
    "video-captions"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^45.4.1",
    "tailwindcss": "^4.0.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
